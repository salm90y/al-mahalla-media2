        android:pathData="M 70,39 L 67,39 C 66,46 66,57 66,63 L 70,63 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M 64,39 L 61,39 C 60,46 60,57 60,63 L 64,63 Z"
        android:fillColor="#FFFFFF" />

