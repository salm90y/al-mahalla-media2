    <!-- Outer Glowing Ring -->
    <path
        android:pathData="M 54,54 m -32,0 a 32,32 0 1,0 64,0 a 32,32 0 1,0 -64,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="22"
                android:endX="86"
                android:endY="86">
                <item android:offset="0.0" android:color="#00D2D3" />
                <item android:offset="0.5" android:color="#0984E3" />
                <item android:offset="1.0" android:color="#6C5CE7" />
